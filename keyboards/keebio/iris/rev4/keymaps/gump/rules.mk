# Tri-layer (LOWER + RAISE = ADJUST) is handled in keymap.c via
# update_tri_layer_state(), so no extra feature flags are needed here.

# WS2812 underglow (6 LEDs per side, 12 total). Configured in config.h.
RGBLIGHT_ENABLE = yes

# VIA runtime remapping + macro editor (usevia.app). Persists to EEPROM.
VIA_ENABLE = yes
